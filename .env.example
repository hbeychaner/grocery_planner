# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_LANGUAGE=en

# Supermarket Optional Credentials
# If left empty, both stores operate in public / anonymous mode.
# If provided, Rohlik will authenticate to retrieve personalized/club discounts.
ROHLIK_USERNAME=
ROHLIK_PASSWORD=

# Kosik Optional User Token
KOSIK_USER_TOKEN=

# Request & Matching Settings
REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=300
MIN_MATCH_SIMILARITY_SCORE=0.55

# Local Ollama LLM Settings (Optional)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_THINK=false

# Langfuse Monitoring (Optional)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
