# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_LANGUAGE=en

# Supermarket Optional Credentials
# If left empty, both stores operate in public / anonymous mode.
# If provided, Rohlik will authenticate to retrieve personalized/club discounts.
ROHLIK_USERNAME=
ROHLIK_PASSWORD=

# Kosik Optional User Token
KOSIK_USER_TOKEN=

# Request & Matching Settings
REQUEST_TIMEOUT_SECONDS=10
CACHE_TTL_SECONDS=300
MIN_MATCH_SIMILARITY_SCORE=0.55

# Per-Service LLM Provider Selection ("ollama" | "gemini")
COMPARISON_LLM_PROVIDER=ollama
AGENT_LLM_PROVIDER=gemini

# Local Ollama LLM Settings (Optional)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_THINK=false
OLLAMA_MAX_CONCURRENCY=1

# Google Gemini Settings (for Agent / Optional Comparison)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Langfuse Monitoring (Self-Hosted Local Docker or Cloud)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme

# Langfuse Self-Hosting Secrets & Headless Initialization (see docker-compose.langfuse.yml)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_openssl_rand_base64_32
SALT=changeme_openssl_rand_base64_32
ENCRYPTION_KEY=changeme_openssl_rand_hex_32
LANGFUSE_INIT_ORG_ID=grocery-planner-org
LANGFUSE_INIT_ORG_NAME=Grocery Planner
LANGFUSE_INIT_PROJECT_ID=grocery-planner-project
LANGFUSE_INIT_PROJECT_NAME=grocery-planner
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@localhost.dev
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=changeme
